    {
      "name": "Route Line",
      "kind": "custom",
      "refersTo": "route-line",
      "description": "Signature: a trip's cities as stations on one thick magenta line. Hub (filled), default, and open (dashed) stops; the new stop draws in and its ring pops.",
      "html": "<ol class=\"ds-route\"><li class=\"ds-stop ds-hub\"><span class=\"ds-name\">Bogota</span><span class=\"ds-meta\">Takeoff · Mar 3</span></li><li class=\"ds-stop ds-new\"><span class=\"ds-name\">Cartagena</span><span class=\"ds-meta\">Mar 5</span></li><li class=\"ds-stop ds-open\"><span class=\"ds-name ds-placeholder\">Next stop</span></li></ol>",
      "css": ".ds-route{position:relative;list-style:none;padding:0;margin:0;}.ds-stop{position:relative;padding-left:3rem;padding-bottom:1.5rem;min-height:3.25rem;}.ds-stop::before{content:'';position:absolute;left:0.625rem;top:0;bottom:0;width:0.5rem;background:var(--color-accent);transform-origin:top;}.ds-stop:first-child::before{top:0.875rem;}.ds-stop:last-child::before{bottom:auto;height:0.875rem;}.ds-stop::after{content:'';position:absolute;left:0;top:0;width:1.75rem;height:1.75rem;box-sizing:border-box;border-radius:9999px;border:0.3125rem solid var(--color-text);background:var(--color-bg);}.ds-hub::after{background:var(--color-accent);}.ds-open::after{border:0.1875rem dashed var(--color-accent);}.ds-open::before{background:linear-gradient(var(--color-accent) 50%,transparent 50%);background-size:100% 0.75rem;}.ds-name{display:block;font-family:var(--font-display),'Arial Narrow',sans-serif;font-weight:700;font-size:1.75rem;line-height:1;letter-spacing:0.02em;text-transform:uppercase;color:var(--color-text);}.ds-placeholder{color:var(--color-text-muted);}.ds-meta{display:block;margin-top:0.25rem;font-family:var(--font-body),system-ui,sans-serif;font-size:0.875rem;color:var(--color-text-muted);}@keyframes ds-line-in{from{transform:scaleY(0)}to{transform:scaleY(1)}}@keyframes ds-station-in{0%{scale:0}60%{scale:1.2}100%{scale:1}}@media (prefers-reduced-motion:no-preference){.ds-new::before{animation:ds-line-in 450ms cubic-bezier(0.22,1,0.36,1) 250ms both;}.ds-new::after{animation:ds-station-in 450ms cubic-bezier(0.22,1,0.36,1) 250ms both;}}"
    },
