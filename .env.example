# Local: SQLite file. Production: Turso URL (libsql://...) + token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Better Auth (magic link). Generate a secret with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend: required in production only (console logging is used in
# dev/test, plan ADR 0005/D-2).
RESEND_API_KEY=

# Optional: force the magic-link sender ("console" or "resend"). Unset
# picks by NODE_ENV: console in dev/test, Resend in production.
# MAGIC_LINK_SENDER=console
